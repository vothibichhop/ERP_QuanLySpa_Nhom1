<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_spa_leave_request_list" model="ir.ui.view">
        <field name="name">spa.leave.request.list</field>
        <field name="model">spa.leave.request</field>
        <field name="arch" type="xml">
            <list string="Nghỉ phép"
                  decoration-muted="state in ['refused', 'cancelled']">
                <field name="employee_id"/>
                <field name="job_id"/>
                <field name="leave_type"/>
                <field name="start_date"/>
                <field name="start_session"/>
                <field name="end_date"/>
                <field name="end_session"/>
                <field name="total_sessions"/>
                <field name="approver_id"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_spa_leave_request_form" model="ir.ui.view">
        <field name="name">spa.leave.request.form</field>
        <field name="model">spa.leave.request</field>
        <field name="arch" type="xml">
            <form string="Đơn nghỉ phép">
                <header>
                    <button name="action_submit" string="Gửi duyệt" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_approve" string="Duyệt" type="object" class="btn-success" groups="spa.group_customer_management_manager,hr.group_hr_manager" invisible="state != 'submitted'"/>
                    <button name="action_refuse" string="Từ chối" type="object" class="btn-secondary" groups="spa.group_customer_management_manager,hr.group_hr_manager" invisible="state != 'submitted'"/>
                    <button name="action_cancel" string="Hủy" type="object" class="btn-danger" invisible="state not in ['draft', 'submitted']"/>
                    <button name="action_cancel" string="Hủy đơn đã duyệt" type="object" class="btn-danger" groups="spa.group_customer_management_manager,hr.group_hr_manager" invisible="state != 'approved'"/>
                    <field name="state" widget="statusbar" readonly="1" statusbar_visible="draft,submitted,approved,refused,cancelled"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="employee_id" readonly="state != 'draft'"/>
                            <field name="job_id"/>
                            <field name="leave_type" readonly="state != 'draft'"/>
                            <field name="start_date" readonly="state != 'draft'"/>
                            <field name="start_session" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="end_date" readonly="state != 'draft'"/>
                            <field name="end_session" readonly="state != 'draft'"/>
                            <field name="total_sessions" readonly="1"/>
                            <field name="approver_id"/>
                        </group>
                    </group>
                    <group>
                        <field name="reason" placeholder="Lý do nghỉ phép..." readonly="state != 'draft'"/>
                        <field name="attachment_ids" widget="many2many_binary" readonly="state != 'draft'"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_spa_leave_request_search" model="ir.ui.view">
        <field name="name">spa.leave.request.search</field>
        <field name="model">spa.leave.request</field>
        <field name="arch" type="xml">
            <search string="Tìm đơn nghỉ phép">
                <field name="employee_id"/>
                <field name="job_id"/>
                <field name="leave_type"/>
                <field name="reason"/>
                <filter name="filter_draft" string="Nháp" domain="[('state', '=', 'draft')]"/>
                <filter name="filter_submitted" string="Chờ duyệt" domain="[('state', '=', 'submitted')]"/>
                <filter name="filter_approved" string="Đã duyệt" domain="[('state', '=', 'approved')]"/>
                <filter name="filter_refused" string="Từ chối" domain="[('state', '=', 'refused')]"/>
                <filter name="filter_cancelled" string="Đã hủy" domain="[('state', '=', 'cancelled')]"/>
                <group expand="0" string="Nhóm theo">
                    <filter name="group_employee" string="Nhân viên" context="{'group_by': 'employee_id'}"/>
                    <filter name="group_job" string="Vị trí công việc" context="{'group_by': 'job_id'}"/>
                    <filter name="group_state" string="Trạng thái" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_spa_leave_request" model="ir.actions.act_window">
        <field name="name">Nghỉ phép</field>
        <field name="res_model">spa.leave.request</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_spa_leave_request_search"/>
    </record>

    <menuitem id="menu_spa_leave_request"
              name="Nghỉ phép"
              parent="menu_customer_management_root"
              action="action_spa_leave_request"
              sequence="15"
              groups="spa.group_customer_management_user"/>

    <menuitem id="menu_spa_leave_request_employees"
              name="Nghỉ phép"
              parent="hr.menu_hr_root"
              action="action_spa_leave_request"
              sequence="30"
              groups="spa.group_customer_management_user"/>
</odoo>
