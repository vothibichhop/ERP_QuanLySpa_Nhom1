<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_spa_work_shift_week_wizard_form" model="ir.ui.view">
        <field name="name">spa.work.shift.week.wizard.form</field>
        <field name="model">spa.work.shift.week.wizard</field>
        <field name="arch" type="xml">
            <form string="Xếp ca theo tuần">
                <sheet>
                    <group>
                        <field name="start_date"/>
                        <field name="end_date" readonly="1"/>
                    </group>
                    <div class="text-muted">
                        Chọn nhân viên riêng cho từng ngày. Để trống ngày nghỉ; các ca được tạo từ 07:00 đến 19:00.
                    </div>
                    <field name="line_ids">
                        <list editable="bottom" create="0" delete="0">
                            <field name="day_offset" column_invisible="1"/>
                            <field name="weekday_name" readonly="1"/>
                            <field name="work_date" readonly="1"/>
                            <field name="employee_ids"
                                   widget="many2many_tags"
                                   domain="[('active', '=', True)]"/>
                        </list>
                    </field>
                </sheet>
                <footer>
                    <button name="action_apply"
                            type="object"
                            string="Lưu lịch tuần"
                            class="btn-primary"/>
                    <button string="Hủy" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_spa_work_shift_week_wizard" model="ir.actions.act_window">
        <field name="name">Xếp ca theo tuần</field>
        <field name="res_model">spa.work.shift.week.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_spa_work_shift_week_wizard_form"/>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_spa_work_shift_week"
              name="Xếp ca theo tuần"
              parent="hr.menu_hr_root"
              action="action_spa_work_shift_week_wizard"
              sequence="6"
              groups="spa.group_customer_management_user"/>
</odoo>
