<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_move_form_spa_discounted_price" model="ir.ui.view">
        <field name="name">account.move.form.spa.discounted.price</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='price_unit']"
                   position="attributes">
                <attribute name="string">Giá gốc</attribute>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='price_unit']"
                   position="after">
                <field name="spa_discounted_price"
                       string="Giá sau giảm"
                       optional="show"
                       readonly="1"/>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='product_id']"
                   position="after">
                <field name="spa_employee_id"
                       string="Nhân viên bán sản phẩm"
                       optional="show"
                       readonly="1"
                       invisible="product_id.type not in ('product', 'consu')"/>
            </xpath>
            <xpath expr="//page[@name='invoice_tab']" position="after">
                <page name="spa_commission_assignment_tab"
                      string="Nhân viên hoa hồng"
                      groups="spa.group_customer_management_manager"
                      invisible="move_type != 'out_invoice'">
                    <field name="spa_sales_commission_ids"
                           readonly="state == 'cancel'">
                        <list editable="bottom" string="Hoa hồng theo sản phẩm">
                            <field name="invoice_id" column_invisible="True"/>
                            <field name="invoice_line_id"
                                   domain="[('move_id', '=', invoice_id), ('display_type', '=', 'product'), ('product_id.type', 'in', ('product', 'consu'))]"
                                   options="{'no_create': True}"/>
                            <field name="employee_id"
                                   required="1"
                                   domain="[('active', '=', True)]"
                                   options="{'no_create': True}"/>
                            <field name="base_amount"
                                   sum="Tổng doanh thu"
                                   readonly="1"/>
                            <field name="rate" readonly="1"/>
                            <field name="commission_amount" readonly="1"/>
                            <field name="state" widget="badge" readonly="1"/>
                            <field name="currency_id" column_invisible="True"/>
                        </list>
                    </field>
                    <div class="text-muted">
                        Chọn nhân viên cho từng dòng sản phẩm để tính hoa hồng 3%.
                        Có thể cập nhật phân công sau khi ghi sổ hóa đơn, trước khi
                        khoản hoa hồng được tạo.
                    </div>
                </page>
            </xpath>
        </field>
    </record>

    <template id="report_invoice_document_spa_discounted_price"
              inherit_id="account.report_invoice_document">
        <xpath expr="//th[@name='th_priceunit']/span" position="replace">
            <span>Giá gốc</span>
        </xpath>
        <xpath expr="//th[@name='th_priceunit']" position="after">
            <th name="th_spa_discounted_price"
                t-attf-class="text-end text-nowrap {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">
                <span>Giá sau giảm</span>
            </th>
        </xpath>
        <xpath expr="//td[@name='td_price_unit']" position="after">
            <td name="td_spa_discounted_price"
                t-attf-class="text-end {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">
                <span class="text-nowrap" t-field="line.spa_discounted_price"/>
            </td>
        </xpath>
    </template>
</odoo>
