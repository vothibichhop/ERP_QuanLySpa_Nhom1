<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_spa_stock_receipt_list" model="ir.ui.view">
        <field name="name">stock.picking.spa.receipt.list</field>
        <field name="model">stock.picking</field>
        <field name="arch" type="xml">
            <list string="Phiếu nhập kho Spa">
                <field name="company_currency_id" column_invisible="True"/>
                <field name="name"/>
                <field name="spa_receipt_date"/>
                <field name="partner_id" string="Nhà cung cấp"/>
                <field name="spa_receipt_invoice_code"/>
                <field name="spa_receipt_employee_id"/>
                <field name="spa_receipt_total_amount" sum="Tổng tiền"/>
                <field name="spa_receipt_status"
                       widget="badge"
                       decoration-success="spa_receipt_status == 'confirmed'"
                       decoration-danger="spa_receipt_status == 'cancelled'"
                       decoration-info="spa_receipt_status == 'draft'"/>
            </list>
        </field>
    </record>

    <record id="view_spa_stock_receipt_form" model="ir.ui.view">
        <field name="name">stock.picking.spa.receipt.form</field>
        <field name="model">stock.picking</field>
        <field name="mode">primary</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="attributes">
                <attribute name="string">Phiếu nhập kho Spa</attribute>
            </xpath>
            <xpath expr="//header/field[@name='state'][1]" position="attributes">
                <attribute name="invisible">True</attribute>
            </xpath>
            <xpath expr="//header/field[@name='state'][1]" position="after">
                <field name="spa_receipt_status"
                       widget="statusbar"
                       statusbar_visible="draft,confirmed,cancelled"/>
            </xpath>
            <xpath expr="//field[@name='origin']" position="after">
                <field name="company_currency_id" invisible="True"/>
                <field name="spa_receipt_date"
                       readonly="state in ['done', 'cancel']"/>
                <field name="spa_receipt_employee_id"
                       readonly="state in ['done', 'cancel']"/>
                <field name="spa_receipt_invoice_code"
                       readonly="state in ['done', 'cancel']"/>
                <field name="spa_receipt_total_amount"
                       readonly="state in ['done', 'cancel']"/>
            </xpath>
            <xpath expr="//field[@name='move_ids_without_package']/list/field[@name='product_uom_qty']"
                   position="after">
                <field name="spa_lot_name"
                       string="Mã lô"
                       optional="show"
                       invisible="parent.picking_type_code != 'incoming'"
                       readonly="parent.state in ['done', 'cancel']"/>
            </xpath>
            <xpath expr="//field[@name='move_ids_without_package']/list/field[@name='product_uom_qty']"
                   position="attributes">
                <attribute name="string">Số lượng dự kiến</attribute>
            </xpath>
            <xpath expr="//field[@name='move_ids_without_package']/list/field[@name='quantity']"
                   position="attributes">
                <attribute name="string">Số lượng nhập</attribute>
                <attribute name="column_invisible">parent.picking_type_code != 'incoming'</attribute>
                <attribute name="readonly">not is_quantity_done_editable or parent.state in ['done', 'cancel']</attribute>
            </xpath>
            <xpath expr="//field[@name='move_ids_without_package']/list/field[@name='product_uom'][@groups='uom.group_uom']"
                   position="attributes">
                <attribute name="string">Đơn vị tính</attribute>
                <attribute name="groups">stock.group_stock_user</attribute>
            </xpath>
            <xpath expr="//field[@name='move_ids_without_package']/list/field[@name='product_uom'][@groups='!uom.group_uom']"
                   position="attributes">
                <attribute name="column_invisible">True</attribute>
            </xpath>
            <xpath expr="//page[@name='note']/field[@name='note']"
                   position="attributes">
                <attribute name="string">Ghi chú</attribute>
                <attribute name="placeholder">Ghi chú cho phiếu nhập kho</attribute>
            </xpath>
        </field>
    </record>

    <record id="view_spa_stock_receipt_search" model="ir.ui.view">
        <field name="name">stock.picking.spa.receipt.search</field>
        <field name="model">stock.picking</field>
        <field name="arch" type="xml">
            <search string="Phiếu nhập kho Spa">
                <field name="name" string="Mã phiếu"/>
                <field name="spa_receipt_invoice_code" string="Mã hóa đơn"/>
                <field name="spa_receipt_employee_id"/>
                <field name="product_id"/>
                <filter name="receipt_draft"
                        string="Nháp"
                        domain="[('state', 'not in', ('done', 'cancel'))]"/>
                <filter name="receipt_confirmed"
                        string="Đã xác nhận"
                        domain="[('state', '=', 'done')]"/>
                <filter name="receipt_cancelled"
                        string="Đã hủy"
                        domain="[('state', '=', 'cancel')]"/>
            </search>
        </field>
    </record>

    <record id="stock.action_picking_tree_incoming" model="ir.actions.act_window">
        <field name="name">Receipts</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_spa_stock_receipt_search"/>
        <field name="domain">[('picking_type_code', '=', 'incoming')]</field>
        <field name="context">{'contact_display': 'partner_address', 'restricted_picking_type_code': 'incoming', 'search_default_reception': 1}</field>
    </record>

    <record id="action_spa_stock_receipts_list"
            model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_spa_stock_receipt_list"/>
        <field name="act_window_id" ref="stock.action_picking_tree_incoming"/>
    </record>

    <record id="action_spa_stock_receipts_form"
            model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_spa_stock_receipt_form"/>
        <field name="act_window_id" ref="stock.action_picking_tree_incoming"/>
    </record>

    <record id="menu_spa_stock_receipts" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>
</odoo>
